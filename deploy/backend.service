[Unit]
Description=Birmas Backend API
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/birmas
EnvironmentFile=/root/birmas/.env
ExecStart=/root/birmas/venv/bin/uvicorn backend.app:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
